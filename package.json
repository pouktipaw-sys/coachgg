{
  "name": "coachgg",
  "version": "0.1.0",
  "private": true,
  "description": "CoachGG AI — coaching League of Legends après match (stats, vidéo annotée, groupes d'amis)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx src/worker/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --trace off",
    "dev:all": "node scripts/dev.mjs",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "test:analysis": ".venv-analysis/bin/python -m unittest discover -s analysis",
    "benchmark:analysis": "tsx scripts/benchmark-analysis.ts",
    "agent": "tsx desktop/src/cli.ts",
    "demo:video": "node scripts/demo-video.cjs",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "^16.4.6",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
