// CoachGG — modèle de données
// Domaines séparés : comptes · identités de jeu · matchs/stats · vidéo · analyses
// · scores · équipes · partages/permissions · objectifs · notifications · jobs.
//
// Règle : toute donnée de démonstration porte isDemo = true et n'est jamais
// mélangée aux calculs réels (scores, MVP, progression).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL : prisma.config.ts (CLI) et adaptateur pg dans src/server/db.ts (application).
}

// ───────────────────────────── Comptes ─────────────────────────────

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions        Session[]
  resetTokens     PasswordResetToken[]
  profile         PlayerProfile?
  gameIdentities  GameIdentity[]
  recordings      Recording[]
  clips           Clip[]
  recommendations Recommendation[]       @relation("RecommendationAuthor")
  annotations     VideoAnnotation[]      @relation("AnnotationAuthor")
  observations    Observation[]          @relation("ObservationAuthor")
  memberships     TeamMembership[]
  invitationsSent TeamInvitation[]       @relation("InvitationInviter")
  invitationsRecv TeamInvitation[]       @relation("InvitationInvitee")
  participants    MatchParticipant[]
  matchesCreated  Match[]                @relation("MatchCreator")
  goals           Goal[]
  feedback        AnalysisFeedback[]
  sharesGranted   SharePermission[]      @relation("ShareGrantor")
  sharesReceived  SharePermission[]      @relation("ShareGranteeUser")
  notifications   Notification[]
  teamsCreated    Team[]                 @relation("TeamCreator")
  devices         Device[]
  pairingCodes    DevicePairingCode[]
  coachThreads    CoachThread[]
  teammates       Teammate[]
  peerVotes       PeerVote[]
  communityPosts  CommunityPost[]
  communityComments CommunityComment[]
  communityLikes  CommunityLike[]
  communityReports CommunityReport[]
  friendRequestsSent Friendship[] @relation("FriendRequester")
  friendRequestsRecv Friendship[] @relation("FriendAddressee")
}

// ─────────────────────────── Coach conversationnel ───────────────────────────
// Chaque réponse conserve les sources citées (identifiants des données autorisées
// au moment de la question), le mode (IA ou règles), le modèle et le coût.

model CoachThread {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  teamId    String? // contexte de groupe éventuel (vérifié à chaque question)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  CoachMessage[]

  @@index([userId, updatedAt])
}

model CoachMessage {
  id                 String      @id @default(cuid())
  threadId           String
  thread             CoachThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role               String // user | assistant
  content            String
  citations          Json? // [{ sourceId, kind, title, link, quote? }]
  missingInformation Json? // string[]
  followUps          Json? // string[]
  mode               String? // llm | rules | llm_fallback_rules
  model              String?
  sourcesCount       Int?
  inputTokens        Int?
  outputTokens       Int?
  cacheReadTokens    Int?
  costMicros         Int? // micro-dollars
  latencyMs          Int?
  warning            String?
  reportedAt         DateTime?
  reportComment      String?
  createdAt          DateTime    @default(now())

  @@index([threadId, createdAt])
}

// ─────────────────────────── Application PC ───────────────────────────
// Un PC appairé reçoit un jeton d'appareil (haché en base), limité à l'envoi
// de vidéos et au signalement de son état. Révocable à tout moment.

model Device {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  platform   String
  appVersion String
  tokenHash  String      @unique
  createdAt  DateTime    @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?
  status     Json? // dernier état signalé (capture, file d'envoi, disque)
  recordings Recording[]

  @@index([userId])
}

model DevicePairingCode {
  id        String    @id // sha256 du code
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id        String   @id // sha256 du jeton (le jeton brut n'est jamais stocké)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id // sha256 du jeton
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────── Identité de jeu & profil ───────────────────────

enum IdentityVerification {
  DECLARED // saisi par l'utilisateur, non prouvé (pas de RSO)
  VERIFIED_RSO // prouvé via Riot Sign On (nécessite une app Riot approuvée)
}

model GameIdentity {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String               @default("riot")
  gameName     String
  tagLine      String
  platform     String // ex. EUW1, NA1, KR
  puuid        String?
  verification IdentityVerification @default(DECLARED)
  isPrimary    Boolean              @default(true)
  // Rang (API Riot LEAGUE-V4), instantané au moment de la récupération
  rank          Json?
  rankFetchedAt DateTime?
  // Synchronisation de l'historique Riot (import complet puis incrémental)
  historySyncedAt DateTime?
  createdAt    DateTime             @default(now())

  @@unique([userId, provider, gameName, tagLine])
  @@index([gameName, tagLine])
  @@index([puuid])
}

enum ExplanationLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LolRole {
  TOP
  JUNGLE
  MIDDLE
  BOTTOM
  UTILITY
}

model PlayerProfile {
  id                    String           @id @default(cuid())
  userId                String           @unique
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryRole           LolRole?
  secondaryRole         LolRole?
  favoriteChampions     String[]
  progressGoal          String?
  explanationLevel      ExplanationLevel @default(INTERMEDIATE)
  explanationDensity    String           @default("normal") // concise | normal | detailed
  language              String           @default("fr")
  // Confidentialité (par défaut : tout privé)
  defaultVideoPrivate   Boolean          @default(true)
  shareStatsWithTeams   Boolean          @default(true)
  retentionDays         Int? // null = conserver jusqu'à suppression manuelle
  // Analyse automatique : découpage en clips des séquences détectées
  autoClipDeaths        Boolean          @default(true)
  autoClipFights        Boolean          @default(false)
  onboardingCompletedAt DateTime?
  updatedAt             DateTime         @updatedAt
}

// ─────────────────────────── Matchs & stats ───────────────────────────

enum MatchSource {
  MANUAL // statistiques saisies par un utilisateur
  RIOT_API // importé via l'API officielle Riot (Match-V5)
  DEMO // données de démonstration, jamais utilisées comme réelles
}

model Match {
  id           String      @id @default(cuid())
  source       MatchSource
  isDemo       Boolean     @default(false)
  riotMatchId  String?     @unique
  platform     String?
  queueId      Int?
  gameMode     String? // ex. RANKED_SOLO, RANKED_FLEX, NORMAL, ARAM, CUSTOM
  gameStartAt  DateTime?
  durationSec  Int
  gameVersion  String?
  createdById  String?
  createdBy    User?       @relation("MatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  // Équipes : totaux nécessaires aux ratios (participation, parts de dégâts)
  teamStats    Json? // { "100": { kills, dragons, barons, towers, ... }, "200": {...} }
  // Timeline MATCH-V5 compacte : positions par minute, kills, objectifs, balises (analyse vidéo précise)
  timelineFacts Json?

  participants MatchParticipant[]
  recordings   Recording[]
  teamReports  TeamMatchReport[]
  observations Observation[]
  peerVotes    PeerVote[]

  @@index([createdById])
}

model MatchParticipant {
  id           String           @id @default(cuid())
  matchId      String
  match        Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId       String? // lien vers un compte CoachGG (via identité de jeu)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  puuid        String?
  riotGameName String?
  riotTagLine  String?
  championName String
  role         LolRole?
  teamSide     Int // 100 (bleu) | 200 (rouge)
  win          Boolean
  createdAt    DateTime         @default(now())

  statistics MatchStatistics?
  scores     PerformanceScore[]
  votesReceived PeerVote[]

  @@index([matchId])
  @@index([userId])
}

model MatchStatistics {
  id                 String           @id @default(cuid())
  participantId      String           @unique
  participant        MatchParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  kills              Int
  deaths             Int
  assists            Int
  // Champs optionnels : null = donnée non disponible (jamais 0 par défaut)
  creepScore         Int? // minions + monstres neutres
  goldEarned         Int?
  damageToChampions  Int?
  damageToObjectives Int?
  visionScore        Int?
  wardsPlaced        Int?
  wardsKilled        Int?
  controlWardsBought Int?
  objectivesTakedowns Int? // dragons + hérauts + nashors + tours auxquels le joueur a participé (si connu)
  items              Int[] // IDs d'objets finaux (si disponibles)
  timeline           Json? // évolution (or/cs par minute) si disponible
}

// ───────────────────────────── Vidéo ─────────────────────────────

enum RecordingStatus {
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum RecordingSource {
  MANUAL_UPLOAD
  DESKTOP_CAPTURE
}

model Recording {
  id               String          @id @default(cuid())
  ownerId          String
  owner            User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  matchId          String?
  match            Match?          @relation(fields: [matchId], references: [id], onDelete: SetNull)
  source           RecordingSource @default(MANUAL_UPLOAD)
  status           RecordingStatus @default(UPLOADING)
  title            String
  originalFilename String
  declaredMime     String
  sizeBytes        BigInt
  receivedBytes    BigInt          @default(0)
  originalKey      String // clé de stockage du fichier envoyé
  playbackKey      String? // MP4 H.264 « faststart » prêt à lire
  thumbnailKey     String?
  durationMs       Int?
  width            Int?
  height           Int?
  fps              Float?
  videoCodec       String?
  // Synchronisation : temps vidéo (ms) correspondant à 00:00 en jeu
  gameStartOffsetMs Int?
  // Zone de la minimap dans l'image, coordonnées normalisées {x,y,w,h} ∈ [0,1]
  minimapRegion    Json?
  errorMessage     String?
  isDemo           Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  clips           Clip[]
  recommendations Recommendation[]
  annotations     VideoAnnotation[]
  observations    Observation[]
  jobs            AnalysisJob[]
  shares          SharePermission[]
  groundTruth     GroundTruthEvent[]
  deviceId        String?
  device          Device?         @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  capturedAt      DateTime?
  clientUploadId  String? // clé d'idempotence fournie par l'appareil
  // Fin d'analyse : bilan écrit de la partie et vidéo récap (moments annotés enchaînés)
  gameReport      Json?
  recapKey        String?
  recapStatus     String? // PENDING | RUNNING | READY | FAILED
  recapError      String?
  recapAt         DateTime?

  @@unique([deviceId, clientUploadId])
  @@index([ownerId, createdAt])
  @@index([matchId])
}

enum MomentKind {
  MISTAKE // décision à revoir
  GOOD_ACTION // bonne action
  OBJECTIVE
  FIGHT // engagement
  MISSED_OPPORTUNITY
  INTERESTING // situation intéressante sans mort
  DEATH // mort (détectée ou marquée) — pas forcément une erreur
}

enum Provenance {
  MANUAL
  AUTOMATIC
}

model Clip {
  id           String     @id @default(cuid())
  recordingId  String
  recording    Recording  @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  kind         MomentKind
  startMs      Int
  endMs        Int
  favorite     Boolean    @default(false)
  personalNote String?
  provenance   Provenance @default(MANUAL)
  // Export vidéo annotée (rendu par le worker)
  exportStatus String? // PENDING | RUNNING | READY | FAILED
  exportKey    String?
  exportError  String?
  exportedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  recommendations Recommendation[]
  communityPosts  CommunityPost[]

  @@index([recordingId])
  @@index([ownerId, createdAt])
}

// ─────────────────────────── Analyses ───────────────────────────

enum JobType {
  EXPORT_CLIP // rendu d'un clip avec annotations incrustées
  PROCESS_RECORDING // validation ffprobe + transcodage + miniature
  ANALYZE_RECORDING // analyse vidéo assistée (phase 4)
  COMPUTE_SCORES
  RIOT_SYNC // import de l'historique Riot (complet ou incrémental)
  RENDER_RECAP // vidéo récap d'une partie analysée
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  NEEDS_REVIEW
  CANCELLED
}

model AnalysisJob {
  id              String     @id @default(cuid())
  type            JobType
  status          JobStatus  @default(PENDING)
  idempotencyKey  String     @unique
  recordingId     String?
  recording       Recording? @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  matchId         String?
  version         String     @default("1")
  payload         Json?
  result          Json?
  attempts        Int        @default(0)
  maxAttempts     Int        @default(3)
  runAfter        DateTime   @default(now())
  lockedAt        DateTime?
  lockedBy        String?
  cancelRequested Boolean    @default(false)
  progress        Int        @default(0) // 0..100
  error           String?
  startedAt       DateTime?
  finishedAt      DateTime?
  processingMs    Int?
  costMicros      Int        @default(0) // coût externe estimé (API/LLM), 0 si local
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  observations Observation[]

  @@index([status, runAfter])
  @@index([recordingId])
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
  INCONCLUSIVE // « le contexte ne permet pas de conclure »
}

enum AnalysisCategory {
  POSITIONING // placement
  MOVEMENT // déplacements
  ENGAGEMENT // engagement / désengagement
  ALLY_SUPPORT
  RESOURCES
  ABILITIES
  VISION
  ROTATIONS
  OBJECTIVES
  COORDINATION
}

model Observation {
  id            String           @id @default(cuid())
  recordingId   String?
  recording     Recording?       @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  matchId       String?
  match         Match?           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  recommendationId String?
  recommendation   Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  analysisJobId String?
  analysisJob   AnalysisJob?     @relation(fields: [analysisJobId], references: [id], onDelete: SetNull)
  timeMs        Int? // horodatage vidéo
  category      AnalysisCategory?
  text          String
  source        String // "video" | "match_data"
  provenance    Provenance
  authorId      String?
  author        User?            @relation("ObservationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  analysisVersion String         @default("manual-1")
  createdAt     DateTime         @default(now())

  @@index([recommendationId])
  @@index([recordingId])
}

enum RecommendationStatus {
  DRAFT
  PUBLISHED
  DISPUTED // signalée comme incorrecte
  REJECTED // proposition automatique rejetée à la revue (conservée pour mesurer la précision)
}

// Un « moment de coaching » : décision analysée à un instant précis de la vidéo.
model Recommendation {
  id               String               @id @default(cuid())
  recordingId      String
  recording        Recording            @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  clipId           String?
  clip             Clip?                @relation(fields: [clipId], references: [id], onDelete: SetNull)
  authorId         String?
  author           User?                @relation("RecommendationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  kind             MomentKind
  category         AnalysisCategory
  title            String
  // Fenêtre pédagogique
  contextStartMs   Int // début du contexte examiné (avant l'action)
  slowdownStartMs  Int // début du ralenti
  decisionMs       Int // pause : instant où une autre décision était possible
  endMs            Int // fin de la séquence
  slowdownRate     Float                @default(0.5)
  interpretation   String
  alternatives     Json // [{ label, conditions, limits }]
  confidence       Confidence
  confidenceReason String
  advice           String
  provenance       Provenance           @default(MANUAL)
  analysisVersion  String               @default("manual-1")
  status           RecommendationStatus @default(PUBLISHED)
  // Analyse automatique : traçabilité et revue humaine
  analysisJobId    String?
  autoEvidence     Json? // mesures brutes ayant déclenché la proposition
  contextSheetKey  String? // planche d'images du contexte précédant l'événement
  humanEdited      Boolean              @default(false)
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  observations Observation[]
  annotations  VideoAnnotation[]
  feedback     AnalysisFeedback[]

  @@index([recordingId, decisionMs])
}

enum CoordinateSpace {
  FRAME // coordonnées normalisées dans l'image vidéo (espace écran, pas le monde 3D)
  MINIMAP // coordonnées normalisées dans la zone minimap de la vidéo
}

model VideoAnnotation {
  id               String          @id @default(cuid())
  recordingId      String
  recording        Recording       @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  recommendationId String?
  recommendation   Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  type             String // path | arrow | zone | marker | highlight | click | text
  startMs          Int
  endMs            Int
  space            CoordinateSpace @default(FRAME)
  geometry         Json // validé par src/lib/annotations/schema.ts
  style            String // actual | alternative | danger | ally | enemy | neutral
  label            String?
  provenance       Provenance      @default(MANUAL)
  schemaVersion    Int             @default(1)
  authorId         String?
  author           User?           @relation("AnnotationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([recordingId, startMs])
}

enum FeedbackKind {
  INCORRECT
  UNCLEAR
  HELPFUL
  CORRECTION
}

model AnalysisFeedback {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationId String?
  recommendation   Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  scoreId          String?
  kind             FeedbackKind
  comment          String?
  resolvedAt       DateTime?
  createdAt        DateTime        @default(now())
}

// ─────────────────────────── Scores ───────────────────────────

model ScoreVersion {
  id           String   @id // ex. "perf-1.0.0"
  description  String
  config       Json // pondérations et repères, figés pour cette version
  experimental Boolean  @default(true)
  createdAt    DateTime @default(now())

  scores  PerformanceScore[]
  reports TeamMatchReport[]
}

model PerformanceScore {
  id             String           @id @default(cuid())
  participantId  String
  participant    MatchParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  scoreVersionId String
  scoreVersion   ScoreVersion     @relation(fields: [scoreVersionId], references: [id])
  overall        Float? // null si données insuffisantes
  components     Json
  positives      Json
  negatives      Json
  missingData    Json
  reliability    String // high | medium | low | insufficient
  computedAt     DateTime         @default(now())

  @@unique([participantId, scoreVersionId])
}

// ─────────────────────────── Équipes ───────────────────────────

enum TeamRole {
  ADMIN
  MEMBER
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  createdById String?
  createdBy   User?    @relation("TeamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  memberships TeamMembership[]
  invitations TeamInvitation[]
  reports     TeamMatchReport[]
  shares      SharePermission[]
  goals       Goal[]
}

model TeamMembership {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

model TeamInvitation {
  id          String           @id @default(cuid())
  teamId      String
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviterId   String
  inviter     User             @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId   String
  invitee     User             @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  expiresAt   DateTime

  @@index([inviteeId, status])
  @@index([teamId])
}

model TeamMatchReport {
  id             String       @id @default(cuid())
  teamId         String
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matchId        String
  match          Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  scoreVersionId String
  scoreVersion   ScoreVersion @relation(fields: [scoreVersionId], references: [id])
  presentUserIds String[]
  mvpUserIds     String[] // plusieurs en cas d'égalité
  isTie          Boolean      @default(false)
  explanation    Json
  distinctions   Json
  computedAt     DateTime     @default(now())

  @@unique([teamId, matchId, scoreVersionId])
}

// ──────────────────────── Partages & permissions ────────────────────────
// L'appartenance à un groupe ne donne JAMAIS accès aux vidéos privées :
// il faut un partage explicite (vers un utilisateur ou un groupe).

model SharePermission {
  id            String    @id @default(cuid())
  recordingId   String
  recording     Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  grantedById   String
  grantedBy     User      @relation("ShareGrantor", fields: [grantedById], references: [id], onDelete: Cascade)
  granteeUserId String?
  granteeUser   User?     @relation("ShareGranteeUser", fields: [granteeUserId], references: [id], onDelete: Cascade)
  granteeTeamId String?
  granteeTeam   Team?     @relation(fields: [granteeTeamId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?

  @@index([recordingId])
  @@index([granteeUserId])
  @@index([granteeTeamId])
}

// ─────────────────────── Objectifs & notifications ───────────────────────

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
  EXPIRED
}

model Goal {
  id               String     @id @default(cuid())
  ownerId          String?
  owner            User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamId           String?
  team             Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title            String
  reason           String?
  expectedBehavior String?
  metric           Json? // { key: "deathsPer10", comparator: "lte", target: 0.5 }
  periodStart      DateTime   @default(now())
  periodEnd        DateTime?
  status           GoalStatus @default(ACTIVE)
  review           String?
  createdAt        DateTime   @default(now())
}

// ─────────────────── Vérité terrain (évaluation de l'analyse) ───────────────────
// Événements RÉELS d'une vidéo, servant uniquement à mesurer la précision de
// l'analyse automatique. Jamais affichés comme des analyses.

enum GroundTruthSource {
  MANUAL // marqué par le propriétaire dans le lecteur
  RIOT_TIMELINE // morts horodatées de la timeline MATCH-V5 (vidéo synchronisée)
  LIVE_CLIENT // événements enregistrés par l'application PC via l'API locale du client (après match)
}

model GroundTruthEvent {
  id          String            @id @default(cuid())
  recordingId String
  recording   Recording         @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  type        String            @default("DEATH")
  videoMs     Int
  source      GroundTruthSource
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([recordingId, type])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// Invitation à un groupe envoyée par email à une personne SANS compte : elle est
// convertie en invitation normale lorsque cette adresse crée son compte.
model TeamEmailInvite {
  id          String    @id // sha256 du jeton
  teamId      String
  email       String
  inviterId   String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?

  @@index([email])
  @@index([teamId])
}

// ─────────────────────────── Coéquipiers & votes ───────────────────────────

/** Coéquipier suivi par un utilisateur (Riot ID déclaré ; pas forcément un compte CoachGG). */
model Teammate {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  gameName  String
  tagLine   String
  platform  String
  puuid     String?
  nickname  String?
  createdAt DateTime @default(now())

  @@unique([ownerId, gameName, tagLine])
  @@index([puuid])
}

/** Note donnée par un joueur à un coéquipier après une partie (élection du MVP et catégories). */
model PeerVote {
  id        String           @id @default(cuid())
  matchId   String
  match     Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  voterId   String
  voter     User             @relation(fields: [voterId], references: [id], onDelete: Cascade)
  targetId  String
  target    MatchParticipant @relation(fields: [targetId], references: [id], onDelete: Cascade)
  score     Int // 1 à 10
  mvp       Boolean          @default(false)
  awards    String[] // catégories attribuées (une cible par catégorie et par votant)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([matchId, voterId, targetId])
  @@index([targetId])
  @@index([voterId])
}

enum FriendStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/** Amitié entre deux comptes CoachGG (demande envoyée via le Riot ID). Accepter = partager un résumé (rang, forme, trophées). */
model Friendship {
  id          String       @id @default(cuid())
  requesterId String
  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// ─────────────────────────── Communauté ───────────────────────────

enum CommunityPostKind {
  CLIP // reel : un clip exporté (extrait annoté), jamais la vidéo complète
  EXPLOIT // « regardez ce que j'ai fait »
  QUESTION // demande de conseil
  DISCUSSION
}

model CommunityPost {
  id        String            @id @default(cuid())
  authorId  String
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind      CommunityPostKind
  title     String
  body      String            @default("")
  clipId    String?
  clip      Clip?             @relation(fields: [clipId], references: [id], onDelete: Cascade)
  hiddenAt  DateTime? // masqué par la modération
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  comments CommunityComment[]
  likes    CommunityLike[]

  @@index([kind, createdAt])
  @@index([authorId])
}

model CommunityComment {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  hiddenAt  DateTime?
  createdAt DateTime      @default(now())

  @@index([postId, createdAt])
}

model CommunityLike {
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([postId, userId])
}

model CommunityReport {
  id         String    @id @default(cuid())
  reporterId String
  reporter   User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String // POST | COMMENT
  targetId   String
  reason     String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([reporterId, targetType, targetId])
  @@index([resolvedAt])
}
