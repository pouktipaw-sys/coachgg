# ─── Base de données (PostgreSQL) ───────────────────────────────
DATABASE_URL="postgresql://coachgg:coachgg@localhost:5432/coachgg"

# ─── Application ────────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Dossier de stockage privé des vidéos (driver local). Jamais servi statiquement.
STORAGE_DIR="./storage"

# ─── Limites vidéo / quotas ─────────────────────────────────────
MAX_UPLOAD_BYTES=4294967296        # 4 Go par fichier
USER_STORAGE_QUOTA_BYTES=21474836480 # 20 Go par utilisateur
MAX_VIDEO_DURATION_SEC=10800        # 3 h
UPLOAD_CHUNK_BYTES=8388608          # 8 Mo par morceau
FFMPEG_THREADS=2
FFMPEG_TIMEOUT_SEC=3600

# ─── Intégrations externes (optionnelles) ───────────────────────
# Clé Riot Games (developer ou production). Sans clé : import Riot désactivé,
# la saisie manuelle des statistiques reste disponible.
RIOT_API_KEY=""

# Email : non implémenté en V1 → les liens (reset, invitations) sont écrits
# dans les logs serveur en développement uniquement.
MAILER="console"
