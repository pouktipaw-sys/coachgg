# ─── Base de données (PostgreSQL) ───────────────────────────────
DATABASE_URL="postgresql://coachgg:coachgg@localhost:5432/coachgg"

# ─── Application ────────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Dossier de stockage privé des vidéos (driver local). Jamais servi statiquement.
STORAGE_DIR="./storage"

# ─── Limites vidéo / quotas ─────────────────────────────────────
MAX_UPLOAD_BYTES=4294967296        # 4 Go par fichier
USER_STORAGE_QUOTA_BYTES=21474836480 # 20 Go par utilisateur
MAX_VIDEO_DURATION_SEC=10800        # 3 h
UPLOAD_CHUNK_BYTES=8388608          # 8 Mo par morceau
FFMPEG_THREADS=2
FFMPEG_TIMEOUT_SEC=3600

# ─── Intégrations externes (optionnelles) ───────────────────────
# Clé Riot Games (developer ou production). Sans clé : import Riot désactivé,
# la saisie manuelle des statistiques reste disponible.
RIOT_API_KEY=""
# Parties importées au maximum lors de la synchronisation de l'historique
RIOT_HISTORY_MAX=200

# Email : envoi réel via SMTP si SMTP_URL est défini (ex. smtps://user:pass@smtp.exemple.fr:465).
# Vide : liens (reset, invitations) écrits dans les logs serveur en développement uniquement.
SMTP_URL=""
MAIL_FROM="CoachGG <no-reply@exemple.fr>"

# ─── Analyse vidéo assistée (phase 4, expérimentale) ────────────
# Python avec OpenCV + NumPy (voir analysis/requirements.txt).
# Par défaut : venv du projet (.venv-analysis/bin/python, ou .venv-analysis\Scripts\python.exe sous Windows).
# ANALYSIS_PYTHON=".venv-analysis/bin/python"
ANALYSIS_TIMEOUT_SEC=1800

# ─── Coach conversationnel (phase 6) ────────────────────────────
# Sans clé : mode sans IA (règles). Avec clé : réponses rédigées par Claude.
ANTHROPIC_API_KEY=""
COACH_MODEL="claude-opus-5-5"
COACH_EFFORT="medium"

# Taille max. du pool de connexions PostgreSQL (adaptateur pg, Prisma 7)
DATABASE_POOL_MAX=10
